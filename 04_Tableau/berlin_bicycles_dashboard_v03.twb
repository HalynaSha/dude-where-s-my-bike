          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Reported Bicycle Thefts by Approximate Time Period </run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='12'>Short offence windows of 3 hours or less (8,402 reports)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analysis_ready_v2.csv+ (Multiple Connections)' name='federated.0i5j4g61v0ejrw12xaieb065uvh0' />
          </datasources>
          <datasource-dependencies datasource='federated.0i5j4g61v0ejrw12xaieb065uvh0'>
            <column caption='Time Period' datatype='string' name='[Calculation_0488216147058692]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0488216149274630] &lt; 6 THEN &quot;Night&quot;&#13;&#10;ELSEIF [Calculation_0488216149274630] &lt; 12 THEN &quot;Morning&quot;&#13;&#10;ELSEIF [Calculation_0488216149274630] &lt; 18 THEN &quot;Afternoon&quot;&#13;&#10;ELSE &quot;Evening&quot;&#13;&#10;END' />
            </column>
            <column caption='Offence Window Hours Numeric' datatype='real' name='[Calculation_0488216147189765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([offence_window_hours])' />
            </column>
            <column caption='Offence Midpoint Hour' datatype='real' name='[Calculation_0488216149274630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    FLOAT([offence_start_hour])&#13;&#10;    + FLOAT([offence_window_hours]) / 2&#13;&#10;) % 24' />
            </column>
            <column caption='analysis_ready_v2.csv' datatype='table' name='[__tableau_internal_object_id__].[analysis_ready_v2.csv_A784270DBF7A416582D1E6CABD133CB0]' role='measure' type='quantitative' />
